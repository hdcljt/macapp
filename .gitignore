# 依赖
node_modules/
.pnp
.pnp.js

# 编译输出
dist/
dist-electron/
release/
out/
*.tsbuildinfo

# electron-config-jsonc：用户本地编辑的副本（仓库根 config.jsonc 仍被 git 跟踪作为打包源）
# - release/<version>/config.jsonc 是 electron-builder extraFiles 拷贝的输出副本
# - dist-electron/config.jsonc 是构建过程中可能出现的副本
release/**/config.jsonc
dist-electron/config.jsonc

# 日志
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 编辑器
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 环境变量
.env.local
.env.*.local

# Electron
.cache/
.electron-cache/

# 打包临时
*.blockmap
